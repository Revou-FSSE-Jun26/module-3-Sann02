# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; only this placeholder template is committed.

# Base URL of the RevoShop Flask API (Module 2), no trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Server-only secret (no NEXT_PUBLIC_ prefix, never sent to the browser).
# Sent as the X-API-Key header when set. Leave empty if the API doesn't need it.
API_SECRET_KEY=your-secret-key-here

# Optional: artificial delay (ms) before each API call, to demo loading.tsx.
API_DEMO_DELAY_MS=0
