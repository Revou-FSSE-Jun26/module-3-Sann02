{
  "name": "revoshop-typescript-tailwind",
  "version": "1.0.0",
  "description": "Typed interactive product catalog — TypeScript + Tailwind CSS fundamentals exercise",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./dist/output.css --minify",
    "watch:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npm run build:ts && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
